# Hedera testnet operator - the account that funds buyers and deploys the pool.
# Account ID in 0.0.x form, NOT the EVM address.
HEDERA_OPERATOR_ID=0.0.10404217
# ECDSA secp256k1 private key, hex. NEVER commit the real value.
HEDERA_OPERATOR_KEY=

# Network
HEDERA_NETWORK=testnet
HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com

# x402 facilitator. Hedera Track 1 requires settlement through Blocky402.
X402_FACILITATOR_URL=https://api.testnet.blocky402.com

# Resource server
PORT=4021
# Where this server is reachable. A pool stores its resource URL on-chain at creation and
# the coordinator matches requests against that string, so this must be the origin the pool
# was opened against. Defaults to http://localhost:$PORT.
#
# The hosted coordinator runs with https://quorum402-coordinator.fly.dev (fly.toml). Set the
# same value here to open a pool that instance can sell - `npm run pool:open` reads this, and
# the origin it writes on-chain is the one that has to answer.
PUBLIC_BASE_URL=
# Where a single (non-pooled) payment is sent. Filled by `npm run accounts:create`.
PAY_TO_ID=

# The subgraph redemption resolves transaction ids through (quorum-scheme.md §8). Without it
# the coordinator still sells seats and settles payments; only redemption is unavailable.
SUBGRAPH_URL=https://quorum402-subgraph.fly.dev/subgraphs/name/quorum402

# Optional. A settled payment that could not be attributed is always written to stderr; give
# this a URL and it is POSTed there too (src/server/failures.ts). Unset, nothing is lost -
# on Fly that line is in `fly logs`.
ALERT_WEBHOOK_URL=
