{
  "name": "quorum402",
  "version": "0.0.0",
  "private": true,
  "description": "An HTTP 402 challenge that a crowd can answer together: threshold-gated, all-or-nothing payments over x402.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "npm run build && npm run typecheck:ts",
    "typecheck:ts": "tsc --noEmit",
    "build": "hardhat build",
    "test": "hardhat test",
    "lint": "npm run lint:sol && npm run lint:ts",
    "lint:sol": "solhint --max-warnings 0 \"contracts/**/*.sol\"",
    "lint:ts": "eslint . --max-warnings 0",
    "accounts:create": "tsx scripts/create-accounts.ts",
    "check:env": "tsx scripts/check-env.ts",
    "check:payto": "tsx scripts/check-contract-payto.ts",
    "deploy": "tsx scripts/deploy.ts",
    "server": "tsx src/server/index.ts",
    "pay": "tsx scripts/pay-once.ts"
  },
  "dependencies": {
    "@hiero-ledger/sdk": "^2.85.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.11",
    "@nomicfoundation/hardhat-node-test-runner": "^3.1.0",
    "@nomicfoundation/hardhat-viem": "^3.0.9",
    "@nomicfoundation/hardhat-viem-assertions": "^3.1.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "hardhat": "^3.15.0",
    "solhint": "^5.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0",
    "viem": "^2.56.3"
  }
}
