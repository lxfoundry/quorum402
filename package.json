{
  "name": "quorum402",
  "version": "0.0.0",
  "private": true,
  "description": "An HTTP 402 challenge that a crowd can answer together: threshold-gated, all-or-nothing payments over x402.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "accounts:create": "tsx scripts/create-accounts.ts",
    "check:env": "tsx scripts/check-env.ts",
    "server": "tsx src/server/index.ts",
    "pay": "tsx scripts/pay-once.ts"
  },
  "dependencies": {
    "@hiero-ledger/sdk": "^2.85.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
